# ── Supabase (서울 리전 ap-northeast-2 프로젝트) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# service_role 키는 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것.
# 클라이언트 번들에 포함되면 전체 데이터 유출로 이어진다.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── 링크 생성 base URL (도메인·경로 하드코딩 금지 — 설계문서 5.2) ──────────────
# 공개 매직링크(/e /j /d /u)는 반드시 이 값으로 생성한다.
NEXT_PUBLIC_BASE_URL=https://castlog.kr

# ── 발송 (단계 14에서 사용) ──────────────────────────────────────────────────
# RESEND_API_KEY=
# SMS_PROVIDER_API_KEY=
# SMS_TEST_MODE=true
