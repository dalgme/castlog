# ── Supabase (서울 리전 ap-northeast-2 프로젝트) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# service_role 키는 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것.
# 클라이언트 번들에 포함되면 전체 데이터 유출로 이어진다.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── 링크 생성 base URL (도메인·경로 하드코딩 금지 — 설계문서 5.2) ──────────────
# 공개 매직링크(/e /j /d /u)는 반드시 이 값으로 생성한다.
NEXT_PUBLIC_BASE_URL=https://castlog.kr

# ── 발송 (단계 14 — CLAUDE.md 5-2) ──────────────────────────────────────────
# 테넌트 SMS API 키 암호화 키 (base64 32바이트). 생성:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 분실 시 저장된 API 키는 복호화 불가 — 각 테넌트가 재등록해야 한다.
SECRETS_ENCRYPTION_KEY=

# 이메일 (Resend — 플랫폼 공용). 미설정 시 테스트 모드(기록만).
# RESEND_API_KEY=
# RESEND_FROM="CASTLOG <no-reply@castlog.kr>"

# true면 SMS 실발송 없이 성공 처리(status 'test') — 개발·스테이징용
SMS_TEST_MODE=true

# ── AI (Anthropic — 서버 전용. 설명·문장화만, 판정 근거 사용 금지 — CLAUDE.md 14-1) ──
# 미설정 시 AI 사유 초안 기능은 우아하게 비활성(전문가 후보 추천은 AI 없이 동작).
# ANTHROPIC_API_KEY=

# 인증 OTP(솔라피, 운영사 계정)는 앱이 아니라 Supabase Edge Function 시크릿:
#   supabase functions secrets set SOLAPI_API_KEY=... SOLAPI_API_SECRET=... \
#     SOLAPI_SENDER=... SEND_SMS_HOOK_SECRET=v1,whsec_...
